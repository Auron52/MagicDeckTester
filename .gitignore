*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# simulation logs (keep the dir itself via .gitkeep so it ships in a fresh clone)
logs/*
!logs/.gitkeep
logs_*/

# A/B harness scratch — kept locally, not committed (scripts, result snapshots, built binaries)
ab_runs/

# regression test run output (ground truth regression_gt.txt IS committed; the
# rest is transient: per-mode summaries, per-case logs, and the results/<mode>.env
# fingerprints that 'regression.sh --accept' promotes into the ground truth)
test/regression_result.txt
test/regression_result_*.txt
test/logs/
test/results/
test/ab_scratch/
