+// RefinePaymentImpl under MTG_PAY_REFINE_BOUND_VERIFY (see there).
+static bool RefineImplChecked(const GameState& pre, const GameState& post, const ManaCost& cost, bool for_creature,
+                              bool creature_ability, int useful, bool no_trade, PayOption& out)
+{
+    const bool found = RefinePaymentImpl(pre, post, cost, for_creature, creature_ability, useful, no_trade, out);
+    static const bool s_verify = EnvOn("MTG_PAY_REFINE_BOUND_VERIFY");
+    if (!s_verify || t_refine_eager_fed) { return found; }
+    const bool cap1 = t_refine_capped;
+    PayOption o2;
+    t_refine_eager_fed = true;
+    const bool f2 = RefinePaymentImpl(pre, post, cost, for_creature, creature_ability, useful, no_trade, o2);
+    t_refine_eager_fed = false;
+    const bool capped = cap1 || t_refine_capped;
+    g_rbound_cmp.fetch_add(1, std::memory_order_relaxed);
+    if (capped) { g_rbound_capped.fetch_add(1, std::memory_order_relaxed); }
+    if (!SameOption(found, out, f2, o2))
+    {
+        g_rbound_bad.fetch_add(1, std::memory_order_relaxed);
+        if (capped) { g_rbound_bad_capped.fetch_add(1, std::memory_order_relaxed); }
+        std::lock_guard<std::mutex> lk(g_print_mu);
+        std::fprintf(stderr, "[pay-refine-bound] MISMATCH%s bill %s: bound %s, eager %s\n", capped ? " (capped)" : "",
+                     cost.ToString().c_str(), found ? TapsText(out).c_str() : "-", f2 ? TapsText(o2).c_str() : "-");
+    }
+    return found;
+}
